#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x59f83ef11bd0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x59f83ef207c0 .scope module, "tb_lfsr" "tb_lfsr" 3 3;
 .timescale -9 -12;
v0x59f83ef3a570_0 .var "clk", 0 0;
v0x59f83ef3a660_0 .net "data", 7 0, v0x59f83ef39fd0_0;  1 drivers
v0x59f83ef3a730_0 .var "data_expected", 7 0;
v0x59f83ef3a800_0 .var/i "i", 31 0;
v0x59f83ef3a8e0_0 .var "reset_n", 0 0;
S_0x59f83ef20950 .scope module, "lfsr_inst" "lfsr" 3 9, 4 1 0, S_0x59f83ef207c0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset_n";
    .port_info 2 /OUTPUT 8 "data";
v0x59f83ef20b50_0 .net "clk", 0 0, v0x59f83ef3a570_0;  1 drivers
v0x59f83ef39fd0_0 .var "data", 7 0;
v0x59f83ef3a0b0_0 .net "reset_n", 0 0, v0x59f83ef3a8e0_0;  1 drivers
E_0x59f83eefa640 .event negedge, v0x59f83ef3a0b0_0, v0x59f83ef20b50_0;
S_0x59f83ef3a1d0 .scope function.vec4.s8, "reference_lfsr_output" "reference_lfsr_output" 3 25, 3 25 0, S_0x59f83ef207c0;
 .timescale -9 -12;
v0x59f83ef3a3b0_0 .var "current_state", 7 0;
; Variable reference_lfsr_output is vec4 return value of scope S_0x59f83ef3a1d0
TD_tb_lfsr.reference_lfsr_output ;
    %load/vec4 v0x59f83ef3a3b0_0;
    %parti/s 7, 0, 2;
    %load/vec4 v0x59f83ef3a3b0_0;
    %parti/s 1, 0, 2;
    %load/vec4 v0x59f83ef3a3b0_0;
    %parti/s 1, 3, 3;
    %xor;
    %load/vec4 v0x59f83ef3a3b0_0;
    %parti/s 1, 5, 4;
    %xor;
    %load/vec4 v0x59f83ef3a3b0_0;
    %parti/s 1, 6, 4;
    %xor;
    %concat/vec4; draw_concat_vec4
    %ret/vec4 0, 0, 8;  Assign to reference_lfsr_output (store_vec4_to_lval)
    %end;
    .scope S_0x59f83ef20950;
T_1 ;
    %wait E_0x59f83eefa640;
    %load/vec4 v0x59f83ef3a0b0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 138, 0, 8;
    %assign/vec4 v0x59f83ef39fd0_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x59f83ef39fd0_0;
    %parti/s 7, 0, 2;
    %load/vec4 v0x59f83ef39fd0_0;
    %parti/s 1, 0, 2;
    %load/vec4 v0x59f83ef39fd0_0;
    %parti/s 1, 3, 3;
    %xor;
    %load/vec4 v0x59f83ef39fd0_0;
    %parti/s 1, 5, 4;
    %xor;
    %load/vec4 v0x59f83ef39fd0_0;
    %parti/s 1, 6, 4;
    %xor;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x59f83ef39fd0_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x59f83ef207c0;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x59f83ef3a570_0;
    %inv;
    %store/vec4 v0x59f83ef3a570_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x59f83ef207c0;
T_3 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59f83ef3a570_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59f83ef3a8e0_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x59f83ef3a8e0_0, 0, 1;
    %load/vec4 v0x59f83ef3a660_0;
    %cmpi/ne 138, 0, 8;
    %jmp/0xz  T_3.0, 6;
    %vpi_call/w 3 43 "$display", "Error: At time %t, data = %b, expected = 10001010", $time, v0x59f83ef3a660_0 {0 0 0};
    %vpi_call/w 3 44 "$finish" {0 0 0};
T_3.0 ;
    %pushi/vec4 138, 0, 8;
    %store/vec4 v0x59f83ef3a730_0, 0, 8;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x59f83ef3a800_0, 0, 32;
T_3.2 ;
    %load/vec4 v0x59f83ef3a800_0;
    %cmpi/s 256, 0, 32;
    %jmp/0xz T_3.3, 5;
    %load/vec4 v0x59f83ef3a730_0;
    %store/vec4 v0x59f83ef3a3b0_0, 0, 8;
    %callf/vec4 TD_tb_lfsr.reference_lfsr_output, S_0x59f83ef3a1d0;
    %store/vec4 v0x59f83ef3a730_0, 0, 8;
    %delay 10000, 0;
    %load/vec4 v0x59f83ef3a660_0;
    %load/vec4 v0x59f83ef3a730_0;
    %cmp/ne;
    %jmp/0xz  T_3.4, 6;
    %vpi_call/w 3 60 "$display", "Error: At time %t, data = %b, expected = %b", $time, v0x59f83ef3a660_0, v0x59f83ef3a730_0 {0 0 0};
    %vpi_call/w 3 61 "$finish" {0 0 0};
T_3.4 ;
    %load/vec4 v0x59f83ef3a800_0;
    %addi 1, 0, 32;
    %store/vec4 v0x59f83ef3a800_0, 0, 32;
    %jmp T_3.2;
T_3.3 ;
    %vpi_call/w 3 66 "$display", "Simulation successful. All test cases passed." {0 0 0};
    %vpi_call/w 3 67 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "lfsr_tb.v";
    "lfsr.v";
